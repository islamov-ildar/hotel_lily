# REG.RU / Apache. Nginx must forward these requests to Apache for these rules to apply.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^hotel-lily\.ru$ [NC]
  RewriteRule ^ https://hotel-lily.ru%{REQUEST_URI} [R=301,L]

  # Avoid two URL forms of the landing page and administrative routes.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(admin|login)/index\.html$ /$1 [R=301,L]
  RewriteRule ^(admin|login)/$ /$1 [R=301,L]
  RewriteRule ^(admin|login)$ $1/index.html [END]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css|webp|avif|png|jpe?g|svg|woff2?|ttf|otf|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
